# Values prefixed with VITE_ are embedded in browser code and are public.
# Use only a Supabase publishable/anon key here, never a service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional n8n integrations. Leave blank unless the workflows are configured.
# Do not place database credentials or provider API keys in these variables.
VITE_N8N_NEW_BOOKING_WEBHOOK=
VITE_N8N_STATUS_WEBHOOK=
